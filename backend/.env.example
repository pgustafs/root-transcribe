# Local development (for the Podman demo, use deploy/settings.env.example).
# Required backing services
POSTGRES_SERVER=localhost
POSTGRES_PASSWORD=change-me
REDIS_URL=redis://localhost:6379/0
KEYCLOAK_URL=http://localhost:8185

# Generate once and keep stable: playback links and voiceprint encryption.
SECRET_KEY=changethis-please-generate-a-strong-random-secret

# Remote OpenAI-compatible speech-to-text service
STT_BASE_URL=http://localhost:8002/v1
STT_MODEL=whisper-large-v3-turbo
STT_API_KEY=

# Optional: meeting notes written by agents. The LLM address switches the feature
# on; the agent runner (agent-runner/) is the service that talks to the model.
LLM_BASE_URL=
LLM_MODEL=
AGENT_RUNNER_URL=http://localhost:8011

# Accept the pyannote model terms before using this token.
HF_TOKEN=

# Use a reachable S3 endpoint and create this bucket before the first upload.
# Example: a separately served SeaweedFS gateway. The bundled pod's S3 port
# is internal and is not published for local development processes.
AUDIO_S3_ENDPOINT_URL=http://localhost:8333
AUDIO_S3_BUCKET=meeting-audio
AUDIO_S3_ACCESS_KEY=change-me
AUDIO_S3_SECRET_KEY=change-me

# Other defaults and operational overrides: app/core/config.py.
