# Local Podman demo. Copy with ./deploy/start.sh init.
# Values are read as data, never executed as shell commands. No variable expansion.
# Internal database, queue, identity and storage defaults are supplied automatically.

# 1. Existing OpenAI-compatible speech-to-text service (reachable from containers).
# See README: Serving Whisper with vLLM and Podman. STT_MODEL must match
# the server's --served-model-name (whisper-large-v3-w4a16 in that guide).
STT_BASE_URL=http://host.containers.internal:8002/v1
STT_MODEL=whisper-large-v3-turbo
STT_API_KEY=

# Optional: a second, text model for meeting notes (summaries, task lists) written
# by agents. OpenAI-compatible, reachable from containers. Leave LLM_BASE_URL empty
# to run without the feature; set LLM_MODEL to the server's model name when used.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Optional, needs the LLM above: a Tavily key (https://tavily.com) lets the
# agent research questions marked in a notebook on the web. Only the question
# is sent out, and only for recordings where the user switched it on.
TAVILY_API_KEY=

# 2. Bundled SeaweedFS creates this bucket automatically.
# S3 credentials are generated and preserved in deploy/secrets.local.json.
AUDIO_S3_BUCKET=meeting-audio

# 3. Token with access to the pyannote models; accept their model terms first.
HF_TOKEN=

# 4. First sign-in. Its password is generated into deploy/secrets.local.json.
KEYCLOAK_APP_ADMIN_EMAIL=admin@example.com

# Optional: keep these for a local demo. For remote access use HTTPS proxies,
# and set these to the public origins. Published host ports remain loopback-only.
APP_URL=http://localhost:8095
KEYCLOAK_URL=http://localhost:8185
